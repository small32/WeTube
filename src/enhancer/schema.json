            "Deep-Dark",
            "Discord",
            "Dracula",
            "Gruvbox-Dark",
            "Gruvbox-Light",
            "Solarized-Dark",
            "Solarized-Light",
            "Catppuccin-Mocha",
            "Arc-Dark",
            "Breeze-Dark",
            "Firefox-Dark",
            "Firefox-Alpenglow-Dark",
            "Firefox-Dark-91",
            "Firefox-57",
            "Mint-Y-Dark",
            "Vertex-Dark",
            "Ubuntu-Grey",
            "Ubuntu-Purple",
            "Adapta-Nokto",
            "Adapta-Breath-Nokto",
            "HavocOS",
            "Inspired-Dark",
            "Jisho",
            "NierAutomata-Dark",
            "NierAutomata-Light",
            "9anime",
            "Black-and-White",
            "Orange",
            "Yellow",
            "Yellow-2",
            "Custom"
          ]
