      "id": "volumeBoost",
      "label": "音量增强",
      "desc": "超过 100% 的音量增益。可以在按钮上滚轮调节，Shift 加速 2.5 倍、Ctrl 加速 5 倍",
      "group": "player",
      "pages": [
        "watch",
        "live",
        "shorts"
      ],
      "fields": [
        {
          "key": "enabled",
          "type": "boolean",
          "default": false,
          "label": "启用"
        },
        {
          "key": "mode",
          "type": "select",
          "default": "global",
          "label": "模式",
          "parent": "enabled",
          "options": [
            "global",
            "per_video"
          ]
        },
        {
          "key": "amount",
          "type": "number",
          "default": 5,
          "min": 1,
