    {
      "id": "playerSpeed",
      "label": "默认播放速度",
      "desc": "打开视频时自动应用指定倍速，也可以按频道单独设置",
      "group": "player",
      "pages": [
        "watch",
        "shorts"
      ],
      "fields": [
        {
          "key": "enabled",
          "type": "boolean",
          "default": false,
          "label": "启用"
