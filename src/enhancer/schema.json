    {
      "id": "playerSpeed",
      "label": "默认播放速度",
      "desc": "打开视频时自动应用指定倍速，也可以按频道单独设置",
      "group": "player",
      "pages": [
        "watch",
        "shorts"
      ],
      "fields": [
        {
          "key": "enabled",
          "type": "boolean",
          "default": false,
          "label": "启用"
        },
        {
          "key": "speed",
          "type": "number",
          "default": 1,
          "min": 0.25,
          "max": 16,
          "step": 0.05,
          "label": "速度",
          "parent": "enabled"
        },
        {
          "key": "channelSpeeds",
          "type": "textarea",
          "default": "",
          "label": "按频道设置",
          "parent": "enabled",
          "placeholder": "频道ID=1.5\n另一个频道ID=2",
          "hint": "每行一条：频道ID=倍速。留空则用上面的全局速度"
        }
      ]
    },
    {
      "id": "playerQuality",
      "label": "默认画质",
      "desc": "打开视频时自动切到指定画质",
      "group": "player",
      "pages": [
        "watch",
        "shorts",
        "live"
      ],
      "fields": [
        {
          "key": "enabled",
          "type": "boolean",
          "default": false,
          "label": "启用"
        },
        {
          "key": "quality",
          "type": "select",
          "default": "hd1080",
          "label": "画质",
          "parent": "enabled",
          "options": [
            "auto",
            "tiny",
            "small",
            "medium",
            "large",
            "hd720",
            "hd1080",
            "hd1440",
            "hd2160",
            "hd2880",
            "highres"
          ]
        },
        {
          "key": "fallbackStrategy",
