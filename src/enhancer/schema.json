        {
          "key": "colors.hoverBackground",
          "type": "color",
          "default": "#4e5467",
          "label": "悬停背景",
          "parent": "enabled"
        },
        {
          "key": "colors.mainText",
          "type": "color",
          "default": "#eeeeee",
          "label": "主文字",
          "parent": "enabled"
        },
        {
          "key": "colors.dimmerText",
          "type": "color",
