          "default": "#367bf0",
          "label": "主色",
          "parent": "enabled"
        },
        {
          "key": "colors.mainBackground",
          "type": "color",
          "default": "#22242d",
          "label": "主背景",
          "parent": "enabled"
        },
        {
          "key": "colors.secondBackground",
          "type": "color",
          "default": "#242730",
          "label": "次级背景",
          "parent": "enabled"
