            "lower",
            "higher"
          ]
        },
        {
          "key": "fpsPreference",
          "type": "select",
          "default": "default",
          "label": "帧率偏好",
          "parent": "enabled",
          "options": [
            "default",
            "higher",
            "lower"
          ]
        },
        {
          "key": "preferPremium",
          "type": "boolean",
          "default": false,
          "label": "优先 Premium 高码率",
          "parent": "enabled"
        }
      ]
    },
    {
      "id": "globalVolume",
      "label": "固定音量",
      "desc": "每次进视频都把音量设成固定值",
      "group": "player",
      "pages": [
        "watch",
        "live",
        "shorts"
      ],
