{
  "version": 1,
  "groups": [
    {
      "id": "content",
      "label": "内容过滤",
      "desc": "隐藏首页、侧栏、评论区里不想看到的东西"
    },
    {
      "id": "player",
      "label": "播放器",
      "desc": "播放速度、音量、画质、字幕等播放相关"
    },
    {
      "id": "shorts",
      "label": "Shorts",
      "desc": "短视频相关"
    },
    {
      "id": "appearance",
      "label": "外观",
      "desc": "主题、布局、每行视频数"
    },
    {
      "id": "advanced",
      "label": "高级",
      "desc": "自定义 CSS、链接处理等"
    },
    {
      "id": "download",
      "label": "下载",
      "desc": "视频/音频下载行为与保存位置"
    }
  ],
  "features": [
    {
      "id": "hideShorts",
      "label": "隐藏 Shorts",
      "desc": "在不同位置隐藏 Shorts 短视频入口",
      "group": "content",
      "pages": [
        "watch",
        "home",
        "search",
        "channel_home",
        "channel_videos",
        "channel_posts",
        "channel_streams",
        "subscriptions"
      ],
      "fields": [
        {
          "key": "enabled",
          "type": "boolean",
          "default": false,
          "label": "启用"
        },
        {
          "key": "home.enabled",
          "type": "boolean",
          "default": false,
          "label": "首页",
          "parent": "enabled"
        },
        {
          "key": "search.enabled",
          "type": "boolean",
          "default": false,
          "label": "搜索结果",
          "parent": "enabled"
        },
        {
          "key": "sidebar.enabled",
          "type": "boolean",
          "default": false,
          "label": "侧边栏",
          "parent": "enabled"
        },
        {
          "key": "subscriptions.enabled",
          "type": "boolean",
          "default": false,
          "label": "订阅页",
          "parent": "enabled"
        },
        {
          "key": "channel.enabled",
          "type": "boolean",
          "default": false,
          "label": "频道页",
          "parent": "enabled"
        },
        {
          "key": "videos.enabled",
          "type": "boolean",
          "default": false,
          "label": "视频页",
          "parent": "enabled"
        }
      ]
    },
    {
      "id": "hidePosts",
